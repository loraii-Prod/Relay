# PostgreSQL connection string
DATABASE_URL="postgresql://relay:relay@localhost:5432/relay?schema=public"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VDO.Ninja carries Relay browser WebRTC media. Relay derives private room IDs
# and room passwords with this server-only secret. Use at least 32 random characters.
RELAY_MEDIA_SECRET="replace-with-a-strong-random-secret"

# Reserved for future signed application/control tokens.
RELAY_TOKEN_SECRET="replace-me"

# Local OBS connector (never expose this token publicly)
RELAY_CONNECTOR_HOST="127.0.0.1"
RELAY_CONNECTOR_PORT="4456"
RELAY_CONNECTOR_TOKEN="replace-with-a-strong-random-local-token"
OBS_WEBSOCKET_URL="ws://127.0.0.1:4455"
OBS_WEBSOCKET_PASSWORD=""
